# Valores do Supabase local (veja com: npx supabase status)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Mostra o botão do Google. Exige o provedor configurado no Supabase.
NEXT_PUBLIC_LOGIN_GOOGLE=false
# Chave secreta do Supabase. Só no servidor.
SUPABASE_SECRET_KEY=
# Notificações no celular. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Endereço de contato do serviço de push, como mailto:material@exemplo.com
VAPID_CONTATO=
# Protege a rotina diária. Use um valor longo e aleatório.
CRON_SECRET=
